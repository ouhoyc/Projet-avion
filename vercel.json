{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/prix.js": {
      "includeFiles": "data.json",
      "maxDuration": 20
    },
    "api/hotels.js": {
      "includeFiles": "guides/*.json",
      "maxDuration": 20
    },
    "api/transports.js": {
      "includeFiles": "guides/*.json",
      "maxDuration": 20
    }
  },
  "rewrites": [
    {
      "source": "/img/:path*",
      "destination": "https://projet-avion-photos.vercel.app/:path*"
    }
  ]
}
